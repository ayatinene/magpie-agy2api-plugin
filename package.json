{
  "name": "magpie-agy2api-plugin",
  "version": "0.1.2",
  "type": "module",
  "license": "CC-BY-NC-SA-4.0",
  "description": "Magpie provider plugin for Antigravity2API with built-in prompt sanitization and cache-aware auxiliary routing",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "magpie-plugin"
  ],
  "exports": {
    "./server": "./index.mjs",
    ".": "./index.mjs"
  },
  "main": "./index.mjs",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "magpie": {
    "name": "Antigravity2API",
    "middleware": "./middleware.mjs",
    "hooks": "./hooks.mjs",
    "icon": "https://raw.githubusercontent.com/Mag1cFall/Antigravity2API/main/web/src/assets/logo.png",
    "page": {
      "title": "Prompt Sanitizer",
      "titles": {
        "zh": "风控提示词清洗"
      },
      "file": "ui/sanitizer-panel.html",
      "icon": "ui/icon.svg",
      "service": {
        "port": 18417,
        "option": "pageServicePort"
      }
    },
    "summary": {
      "en": "Antigravity2API provider plugin with cookie-authenticated admin discovery, shared/family pool quota deduplication, fault isolation, cache-aware auxiliary routing, and single-pass prompt sanitization with visual rule editor.",
      "zh": "Antigravity2API 专用插件：管理员会话认证、全动态模型发现、共享/家庭组配额去重、故障隔离规范化、缓存感知辅助路由与单遍无时限提示词清洗及可视化规则编辑。"
    },
    "options": {
      "promptSanitizer": true,
      "promptRewrite": {
        "enabled": true,
        "normalize_identity": true,
        "sideload_mode": "off",
        "sanitize_tools_description": true
      },
      "showAccountDetails": true,
      "refreshOnUsage": true,
      "foldEffortVariants": false,
      "preserveCacheEffort": true,
      "auxIncompatiblePolicy": "current_low",
      "auxFallbackModel": "",
      "auxFallbackEffort": "low",
      "auxMinBodyBytes": 32768,
      "auxMaxOutputTokens": 8192,
      "auxSessionTtlSec": 600,
      "cacheTtlSec": 10,
      "refreshCooldownSec": 60,
      "maxAccountDetails": 0,
      "pageServicePort": 18417
    }
  },
  "author": "ayatinene",
  "repository": {
    "type": "git",
    "url": "https://github.com/ayatinene/magpie-agy2api-plugin.git"
  },
  "homepage": "https://github.com/ayatinene/magpie-agy2api-plugin#readme",
  "bugs": {
    "url": "https://github.com/ayatinene/magpie-agy2api-plugin/issues"
  }
}
